# Copy to .env and replace placeholders. Never commit the populated file.
FLASK_ENV=production
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1/REPLACE_DATABASE
PUBLIC_BASE_URL=http://REPLACE_HOST
FREO_DOMAIN=REPLACE_HOST
LOG_LEVEL=INFO
FREO_MEDIA_ROOT=/var/lib/freo/media
# Optional web upload cap, 1 MiB to 128 MiB. Nginx route caps the full request at 129 MiB.
# MAX_MEDIA_UPLOAD_BYTES=134217728
# Radio engine deployment paths; the current web app does not consume these values.
# ICECAST_HOST=127.0.0.1
# ICECAST_PORT=8001
# ICECAST_CONFIG_PATH=/etc/freo/icecast.xml
# ICECAST_CREDENTIALS_PATH=/etc/freo/icecast-credentials
# LIQUIDSOAP_CONFIG_PATH=/etc/freo/liquidsoap.liq
# LIQUIDSOAP_CONTROL_SOCKET=/run/freo/liquidsoap.sock

# Maximum non-deleted stations, including stopped stations. 0 means unlimited.
FREO_MAX_STATIONS=3

# Every existing public hostname/IP beyond PUBLIC_BASE_URL and FREO_DOMAIN.
FREO_INSTALLATION_HOSTS=
# Trusted public proxy hostname/IPs used for station domain verification.
FREO_DOMAIN_TARGET_HOST=
FREO_DOMAIN_TARGET_IPS=

# Optional LIVE MIC WebRTC gateway; install requirements-live-mic.txt and freo-mic.service.
# Enable only after station rendering and ICE network configuration; see docs/live-mic.md.
FREO_LIVE_MIC=0
FREO_MIC_ICE_SERVERS=[]
FREO_MIC_BROWSER_ICE_SERVERS=[]
