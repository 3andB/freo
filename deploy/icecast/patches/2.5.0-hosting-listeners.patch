+/* Slots are acquired before HTTP success or enqueue, under the global mutex.
+ * Source/statistics clients never acquire a slot. Mount moves keep their slot.
+ * Count even without a limit so enabling/reducing a limit needs no disconnect.
+ */
+static unsigned long freo_listeners = 0;
+int client_freo_broadcast_inhibited(void)
+{
+    if (access("/var/lib/freo-hosting/inhibit", F_OK) == 0 || errno != ENOENT)
+        return 1;
+    if (access("/var/lib/freo-hosting/enabled", F_OK) == 0 &&
+            access("/etc/freo/hosting.json", R_OK) != 0)
+        return 1;
+    return 0;
+}
+int client_freo_admit_listener(client_t *client)
+{
+    ice_config_t *config;
+    int accepted = 0;
+    global_lock();
+    config = config_get_config();
+    if (!client_freo_broadcast_inhibited() && (client->freo_listener_slot || config->freo_listener_limit < 0 ||
+            freo_listeners < (unsigned long)config->freo_listener_limit)) {
+        if (!client->freo_listener_slot) {
+            client->freo_listener_slot = 1;
+            freo_listeners++;
+        }
+        accepted = 1;
+    }
+    stats_event_args(NULL, "freo_listener_limit", "%d", config->freo_listener_limit);
+    stats_event_args(NULL, "freo_listeners", "%lu", freo_listeners);
+    config_release_config();
+    global_unlock();
+    return accepted;
+}
