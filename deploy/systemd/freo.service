[Unit]
Description=Freo web application
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=freo
Group=freo
WorkingDirectory=/opt/freo
EnvironmentFile=/opt/freo/.env
ExecStart=/opt/freo/venv/bin/gunicorn --workers 2 --no-control-socket --bind 127.0.0.1:8000 wsgi:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/freo/uploads
UMask=0027

[Install]
WantedBy=multi-user.target
