[Unit]
Description=Freo public schedule publishing and feedback retention
After=network.target postgresql.service

[Service]
Type=oneshot
User=freo-automation
Group=freo-automation
SupplementaryGroups=freo
WorkingDirectory=/opt/freo
EnvironmentFile=/opt/freo/.env
ExecStart=/opt/freo/venv/bin/flask --app app:create_app refresh-public-schedules
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
