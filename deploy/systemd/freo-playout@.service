[Unit]
Description=Freo station playout %i
After=network.target icecast2.service
Requires=icecast2.service

[Service]
Type=simple
User=freo-playout
Group=freo-playout
WorkingDirectory=/var/lib/freo/playout
ExecStartPre=/usr/bin/python3 /opt/freo/scripts/validate-station-instance.py %i
ExecStart=/usr/bin/liquidsoap /etc/freo/radio/stations/%i.liq
Restart=on-failure
RestartSec=5
RuntimeDirectory=freo/playout/%i
RuntimeDirectoryMode=0711
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/freo/playout/%i /var/lib/freo/playout
UMask=0007

[Install]
WantedBy=multi-user.target
