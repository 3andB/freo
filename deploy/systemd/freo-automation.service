[Unit]
Description=Freo automation worker
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=freo-automation
Group=freo-automation
SupplementaryGroups=freo freo-playout
WorkingDirectory=/opt/freo
EnvironmentFile=/opt/freo/.env
ExecStart=/opt/freo/venv/bin/python -m app.automation_worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
